# Пример переменных окружения. Скопируйте в deploy/alwaysdata/.env
# (для Alwaysdata) или задайте их в панели хостинга / Docker.
#
# ВАЖНО: настоящий .env в репозиторий не попадает (см. .gitignore).

# Режим: production | development | testing
APP_ENV=production

# Ключ подписи сессий. Сгенерируйте один раз:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Пустое значение больше не ломает приложение: будет создан постоянный ключ
# в data/.secret_key. Для продакшена лучше задать явно.
SECRET_KEY=

# Где лежат база и загруженные PDF.
# На Alwaysdata удобно держать внутри проекта:
#   DATABASE_PATH=/home/<логин>/edu-math/data/math_tutor.db
#   UPLOAD_DIR=/home/<логин>/edu-math/data/uploads
DATABASE_PATH=
UPLOAD_DIR=

# За HTTPS-прокси (Alwaysdata): доверять X-Forwarded-* и ставить Secure-cookie.
TRUST_PROXY=1
COOKIE_SECURE=1

# Лимит загружаемого PDF, МБ
MAX_UPLOAD_MB=60

# e-padruchnik: auto — локальный каталог, если он есть; catalog — только
# каталог; live — всегда ходить на портал (нужно для тестов).
PADRUCHNIK_MODE=auto
# Необязательный HTTP(S)-прокси для скачивания PDF с портала, если его IP
# заблокирован хостингом: http://user:pass@proxy.example:3128
PADRUCHNIK_PROXY=
# Необязательный внешний релей PDF: шаблон с {url} или базовый URL.
PADRUCHNIK_PDF_RELAY=

# Первый администратор. Если задать ADMIN_PASSWORD, при первом запуске
# будет создан admin с этим паролем (по умолчанию — math2025).
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Необязательный ИИ (по умолчанию выключен; включается в /admin/ai)
AI_TIMEOUT=45
AI_MAX_PER_HOUR=60

# Журналирование
LOG_LEVEL=INFO

# Вход через Google (OAuth 2.0). Создайте OAuth client ID типа Web application:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<сайт>/auth/google/callback
# Пока оба значения пусты, кнопка «Войти через Google» не показывается.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Альтернатива переменным окружения: файл data/google_oauth.json
#   {"client_id": "...", "client_secret": "..."}
# Необязательно: точный redirect URI, если сайт за прокси.
GOOGLE_REDIRECT_URI=
# Таймаут запросов к Google, секунд.
GOOGLE_TIMEOUT=15
