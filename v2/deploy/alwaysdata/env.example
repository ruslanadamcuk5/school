# Переменные окружения v2 (AlwaysData).
# Скопируйте в ~/edu-math-v2/.env.v2 и выставьте права: chmod 600 .env.v2
# Значения ниже — примеры, замените на реальные из панели AlwaysData.

# PostgreSQL из панели: Databases → PostgreSQL → ваша база.
# Хост обычно postgresql-<аккаунт>.alwaysdata.net, порт 5432.
DATABASE_URL='postgresql://virusadk_school:ПАРОЛЬ@postgresql-virusadk.alwaysdata.net:5432/virusadk_school'

# Случайная строка ≥ 32 символов: python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
SECRET_KEY='ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ'

# Пароль администратора (используется при первичном создании/сбросе admin).
ADMIN_PASSWORD='ЗАМЕНИТЕ'

# Куда складывать загруженные PDF и обложки.
UPLOAD_DIR='/home/virusadk/edu-math-v2/data/uploads'
DATABASE_PATH='/home/virusadk/edu-math-v2/data/math_tutor.db'
